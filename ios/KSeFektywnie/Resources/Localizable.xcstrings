          "stringUnit": {
            "state": "translated",
            "value": "%@ — saved %@. You will need to enter the KSeF token again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: guardado %@. Tendrás que volver a introducir el token de KSeF."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — збережено %@. Токен KSeF потрібно буде ввести знову."
