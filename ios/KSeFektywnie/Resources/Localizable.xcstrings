          }
        }
      }
    },
    "Po włączeniu aplikacja wymaga uwierzytelnienia przy uruchomieniu i po powrocie z tła.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, the app requires authentication at launch and when returning from the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se activa, la aplicación pedirá autenticación al abrirse y al volver del segundo plano."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після ввімкнення застосунок вимагатиме автентифікації під час запуску та після повернення з фону."
          }
        }
      }
    },
