    "Brak faktur do zapłaty. Zatwierdź fakturę do zapłaty w zakładce Faktury — pojawi się tutaj.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No invoices to pay. Approve an invoice for payment in the Invoices tab — it will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay facturas por pagar. Aprueba una factura para pago en la pestaña Facturas y aparecerá aquí."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає рахунків-фактур до оплати. Затвердьте рахунок-фактуру до оплати на вкладці «Фактури» — він з'явиться тут."
          }
        }
      }
    },
    "Brak faktur sprzedażowych": {
      "localizations": {
        "en": {
