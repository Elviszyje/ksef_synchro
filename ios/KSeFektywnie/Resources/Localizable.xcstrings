    "Wystaw pierwszą fakturę. Wpisane pozycje i nabywcy zostaną zapamiętani do kolejnych faktur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Issue your first invoice. Items and buyers you enter will be remembered for future invoices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emite tu primera factura. Las líneas y compradores que introduzcas se recordarán para próximas facturas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виставте перший рахунок-фактуру. Введені позиції та покупці запам'ятаються для наступних рахунків."
          }
        }
      }
    },
    "Wystawiona: %@": {
      "localizations": {
