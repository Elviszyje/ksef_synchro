    },
    "Wysyłka do KSeF pojawi się w kolejnej wersji roboczej. Szkic możesz już zapisać i wyeksportować jako XML FA(3).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending to KSeF will arrive in the next development build. You can already save the draft and export it as FA(3) XML."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío a KSeF llegará en la próxima versión de desarrollo. Ya puedes guardar el borrador y exportarlo como XML FA(3)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання до KSeF з'явиться в наступній робочій версії. Чернетку вже можна зберегти та експортувати як XML FA(3)."
          }
        }
      }
    },
