    "Token jest nieprawidłowy, wygasł albo został wygenerowany dla innego NIP. Wygeneruj nowy token.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is invalid, has expired or was generated for a different NIP. Generate a new token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token no es válido, ha caducado o se generó para otro NIP. Genera un token nuevo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Токен недійсний, прострочений або згенерований для іншого NIP. Згенеруйте новий токен."
          }
        }
      }
    },
    "Token jest przechowywany wyłącznie w pęku kluczy tego iPhone'a. Nie trafia do kopii zapasowej ani do iCloud.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is stored only in this iPhone's keychain. It is not included in backups or iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token se guarda solo en el llavero de este iPhone. No se incluye en copias de seguridad ni en iCloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Токен зберігається лише у в'язці ключів цього iPhone. Він не потрапляє до резервних копій чи iCloud."
          }
        }
      }
    },
    "Token nie jest przenoszony na inne urządzenia. Na nowym iPhonie wklej token ponownie albo wygeneruj nowy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is not transferred to other devices. On a new iPhone, paste the token again or generate a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token no se transfiere a otros dispositivos. En un iPhone nuevo, pega el token de nuevo o genera uno nuevo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Токен не переноситься на інші пристрої. На новому iPhone вставте токен знову або згенеруйте новий."
          }
        }
      }
    },
    "Token nie ma potrzebnych uprawnień. Wygeneruj token z uprawnieniem do przeglądania faktur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token lacks the required permissions. Generate a token with permission to view invoices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token no tiene los permisos necesarios. Genera un token con permiso para consultar facturas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Токен не має потрібних повноважень. Згенеруйте токен із повноваженням на перегляд рахунків-фактур."
          }
        }
      }
    },
