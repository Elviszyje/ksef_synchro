    "Pozycje trafiają tu automatycznie po zapisaniu faktury sprzedażowej.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items are added here automatically when you save a sales invoice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas se añaden aquí automáticamente al guardar una factura de venta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позиції потрапляють сюди автоматично після збереження рахунку-фактури на продаж."
          }
        }
      }
    },
    "Pozycje ze stawką ZW wymagają podania podstawy prawnej zwolnienia z VAT.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VAT-exempt (ZW) items require the legal basis for the exemption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas exentas (ZW) requieren la base legal de la exención de IVA."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позиції зі ставкою ZW потребують правової підстави звільнення від ПДВ."
          }
        }
      }
    },
    "Połącz aplikację z KSeF w Ustawieniach, aby pobrać faktury kosztowe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the app to KSeF in Settings to download purchase invoices."
