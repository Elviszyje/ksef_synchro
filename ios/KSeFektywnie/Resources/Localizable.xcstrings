            "state": "translated",
            "value": "Elige una cuenta para la transferencia o añádela en Ajustes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть рахунок для переказу або додайте його в Налаштуваннях."
          }
        }
      }
    },
