    "Środowisko testowe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test environment"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entorno de pruebas"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестове середовище"
          }
        }
      }
    },
    "Środowisko testowe ma osobne dane i osobne tokeny. Token z produkcji nie działa na teście i odwrotnie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test environment has separate data and separate tokens. A production token does not work in test, and vice versa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno de pruebas tiene datos y tokens propios. Un token de producción no funciona en pruebas, y viceversa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестове середовище має окремі дані й окремі токени. Токен із виробничого не працює в тестовому, і навпаки."
          }
        }
      }
    },
    "Środowisko testowe służy do prób i ma osobne dane oraz tokeny. Do pracy na prawdziwych fakturach wybierz produkcyjne.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test environment is for trying things out and has separate data and tokens. Choose production to work with real invoices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno de pruebas sirve para hacer pruebas y tiene datos y tokens propios. Para trabajar con facturas reales, elige producción."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестове середовище призначене для спроб і має окремі дані та токени. Для роботи зі справжніми рахунками-фактурами виберіть виробниче."
          }
        }
      }
    }
  },
  "version": "1.0"
