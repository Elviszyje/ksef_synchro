    "KS-eFektywnie nie jest aplikacją Ministerstwa Finansów.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KS-eFektywnie is not an app of the Polish Ministry of Finance."
          }
        },
        "es": {
          "stringUnit": {
