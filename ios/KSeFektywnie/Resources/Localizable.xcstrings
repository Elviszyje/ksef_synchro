    "Faktur": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Facturas"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунків-фактур"
          }
        }
      }
    },
    "Faktura": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Factura"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок-фактура"
          }
        }
      }
    },
    "Faktura %@ na %@ zostanie wysłana do produkcyjnego KSeF. Po przyjęciu jest wystawiona i nie można jej usunąć — błędy poprawia się fakturą korygującą.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoice %@ for %@ will be sent to production KSeF. Once accepted it is legally issued and cannot be deleted — mistakes are fixed with a correcting invoice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La factura %@ por %@ se enviará al KSeF de producción. Una vez aceptada queda emitida y no se puede eliminar; los errores se corrigen con una factura rectificativa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок-фактуру %@ на %@ буде надіслано до виробничого KSeF. Після прийняття її виставлено, і видалити її не можна — помилки виправляють коригувальним рахунком-фактурою."
          }
        }
      }
    },
    "Faktura %@ nie jest „Do zapłaty” albo nie ma numeru rachunku.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoice %@ is not “To pay” or has no bank account number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La factura %@ no está «Por pagar» o no tiene número de cuenta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок-фактура %@ не має статусу «До оплати» або не має номера рахунку."
          }
        }
      }
    },
    "Faktura ma niekompletne dane.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invoice has incomplete data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La factura tiene datos incompletos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок-фактура має неповні дані."
          }
        }
      }
    },
    "Faktura o numerze %@ już istnieje.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An invoice numbered %@ already exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una factura con el número %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок-фактура з номером %@ уже існує."
          }
        }
      }
    },
    "Faktura zawiera pozycje ze stawką ZW. KSeF wymaga wskazania podstawy prawnej zwolnienia: przepisu ustawy o VAT (lub aktu wykonawczego), dyrektywy 2006/112/WE albo innej podstawy. Wcześniej użyte podstawy są zapamiętywane.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invoice has VAT-exempt (ZW) items. KSeF requires the legal basis for the exemption: a provision of the Polish VAT Act (or its regulations), of Directive 2006/112/EC, or another basis. Previously used bases are remembered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La factura tiene líneas exentas de IVA (ZW). KSeF exige la base legal de la exención: una disposición de la ley polaca del IVA (o su reglamento), de la Directiva 2006/112/CE u otra base. Las bases usadas antes se recuerdan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок-фактура містить позиції зі ставкою ZW. KSeF вимагає вказати правову підставу звільнення: положення польського закону про ПДВ (або підзаконного акта), Директиви 2006/112/ЄС чи іншу підставу. Раніше використані підстави запам'ятовуються."
          }
        }
      }
    },
    "Faktura zostanie wysłana do środowiska testowego KSeF. Nie ma skutków prawnych.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invoice will be sent to the KSeF test environment. It has no legal effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La factura se enviará al entorno de pruebas de KSeF. No tiene efectos legales."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок-фактуру буде надіслано до тестового середовища KSeF. Вона не має правових наслідків."
          }
        }
      }
    },
    "Faktury": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Facturas"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фактури"
          }
        }
      }
    },
    "Faktury (JSON i XML), pliki przelewów i wyciągi są zapisywane jako zwykłe pliki. Token KSeF nigdy nie trafia do katalogu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoices (JSON and XML), transfer files and statements are saved as regular files. The KSeF token never goes into the folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las facturas (JSON y XML), los archivos de transferencias y los extractos se guardan como archivos normales. El token de KSeF nunca se guarda en la carpeta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки-фактури (JSON і XML), файли переказів і виписки зберігаються як звичайні файли. Токен KSeF ніколи не потрапляє до теки."
          }
        }
      }
    },
    "Faktury czekające na pobranie treści: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoices waiting for content download: %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Facturas pendientes de descargar contenido: %lld"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки-фактури, що очікують завантаження вмісту: %lld"
          }
        }
      }
    },
    "Faktury do zapłaty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoices to pay"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Facturas por pagar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки-фактури до оплати"
          }
        }
      }
    },
    "Faktury kosztowe z KSeF, pliki przelewów i rozliczanie wyciągów — wszystko na Twoim telefonie, bez zakładania konta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase invoices from KSeF, bank transfer files and statement reconciliation — all on your phone, no account needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Facturas de compra desde KSeF, archivos de transferencias y conciliación de extractos: todo en tu teléfono, sin crear una cuenta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхідні рахунки-фактури з KSeF, файли переказів і звірка виписок — усе на вашому телефоні, без створення облікового запису."
          }
        }
      }
    },
    "Faktury w innych walutach (%lld) nie są wliczane do sum.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoices in other currencies (%lld) are not included in the totals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las facturas en otras monedas (%lld) no se incluyen en los totales."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки-фактури в інших валютах (%lld) не враховуються в сумах."
          }
        }
      }
    },
    "Faktury w pliku": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoices in the file"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Facturas en el archivo"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки-фактури у файлі"
          }
        }
      }
    },
    "Faktury zmienią status na „Przelew przygotowany”. Plik zaimportuj w bankowości internetowej.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invoices will change to “Transfer prepared”. Import the file in your online banking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las facturas pasarán a «Transferencia preparada». Importa el archivo en tu banca en línea."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки-фактури отримають статус «Переказ підготовлено». Імпортуйте файл в інтернет-банкінгу."
          }
        }
      }
    },
    "Faktury, pliki przelewów, wyciągi i token KSeF zostaną usunięte z telefonu. Pliki w iCloud Drive też znikną przy najbliższym zapisie — wyłącz wcześniej kopię w iCloud, jeśli chcesz je zachować.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoices, transfer files, statements and the KSeF token will be removed from this phone. Files in iCloud Drive will also disappear on the next save — turn off the iCloud copy first if you want to keep them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las facturas, archivos de transferencias, extractos y el token de KSeF se eliminarán del teléfono. Los archivos de iCloud Drive también desaparecerán en el siguiente guardado: desactiva antes la copia en iCloud si quieres conservarlos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки-фактури, файли переказів, виписки й токен KSeF буде видалено з телефону. Файли в iCloud Drive теж зникнуть під час наступного збереження — спершу вимкніть копію в iCloud, якщо хочете їх зберегти."
          }
        }
      }
    },
    "Fakturę można edytować tylko w statusie szkicu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invoice can only be edited as a draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La factura solo se puede editar como borrador."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок-фактуру можна редагувати лише як чернетку."
          }
        }
      }
    },
    "Fakturę można wysłać tylko jako szkic albo po odrzuceniu przez KSeF.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invoice can only be sent as a draft or after KSeF rejected it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La factura solo se puede enviar como borrador o tras ser rechazada por KSeF."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок-фактуру можна надіслати лише як чернетку або після відхилення KSeF."
          }
        }
      }
    },
    "Fikcyjna firma i faktury, bez łączenia z KSeF. Dane demo usuniesz w Ustawieniach.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fictitious company and invoices, without connecting to KSeF. You can delete the demo data in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una empresa y facturas ficticias, sin conectarse a KSeF. Puedes eliminar los datos de demostración en Ajustes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вигадана компанія та рахунки-фактури, без підключення до KSeF. Демо-дані можна видалити в Налаштуваннях."
          }
        }
      }
    },
